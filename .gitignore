/ios/SPMDNLibrary/

# Build artifact, not a repo. Generated by DNLibrary/scripts/publish-spm.sh
# in `local` mode. Never committed anywhere.
/ios/DNLibraryLocal/

# Native Android app — not created yet, will be its own repo
/android/

